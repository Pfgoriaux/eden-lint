{
  "name": "@eden/lint",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Biome config, Biome GritQL plugins, anti-slop Oxlint rules, and env-var naming checks for eden projects.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "eden-lint": "./bin/eden-lint.mjs"
  },
  "exports": {
    "./biome": "./biome.base.json",
    "./oxlint": "./oxlint.base.json",
    "./anti-slop": "./dist/anti-slop/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "biome",
    "biome.base.json",
    "oxlint.base.json",
    "bin",
    "env/*.mjs",
    "env/registry.json",
    "lib/*.mjs",
    "ratchet/*.mjs",
    "ledger/*.mjs"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check": "pnpm lint && pnpm lint:ratchet && pnpm lint:ledger && pnpm test && pnpm typecheck && pnpm check:dist",
    "lint": "node bin/eden-lint.mjs check",
    "lint:ratchet": "node bin/eden-lint.mjs ratchet",
    "lint:ledger": "node bin/eden-lint.mjs ledger check",
    "test": "pnpm test:anti-slop && pnpm test:biome && pnpm test:env && pnpm test:ratchet && pnpm test:ledger",
    "test:anti-slop": "for f in anti-slop/rules/*.test.ts; do tsx \"$f\" || exit 1; done",
    "test:biome": "node scripts/test-biome-plugins.mjs",
    "test:env": "node --test 'env/test/*.test.mjs'",
    "test:ratchet": "node --test 'ratchet/test/*.test.mjs'",
    "test:ledger": "node --test 'ledger/test/*.test.mjs'",
    "typecheck": "tsc --noEmit -p .",
    "check:dist": "pnpm build && git diff --exit-code -- dist && test -z \"$(git ls-files --others --exclude-standard dist)\""
  },
  "dependencies": {
    "@oxlint/plugins": "1.86.0",
    "oxlint": "1.86.0"
  },
  "peerDependencies": {
    "@biomejs/biome": ">=2.5.15"
  },
  "devDependencies": {
    "@eden/lint": "link:.",
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.2.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@10.33.0"
}
